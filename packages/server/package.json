{
  "name": "@halfhalf/server",
  "version": "0.1.0",
  "private": true,
  "description": "HalfHalf 后端服务 — Markdown 自动分页排版引擎",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const f=require('node:fs');f.cpSync('src/templates','dist/templates',{recursive:true});f.cpSync('src/workers','dist/workers',{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "test": "tsx --test test/unit/*.test.ts",
    "test:persistence": "tsx test/run-persistence-e2e.ts",
    "bench": "tsx test/run-bench.ts",
    "bench:document": "tsx test/run-document-bench.ts",
    "bench:research": "tsx --env-file-if-exists=../../.env test/run-research-bench.ts",
    "eval": "tsx --env-file-if-exists=../../.env test/run-eval.ts",
    "qc:render": "tsx test/run-render-qc.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "katex": "^0.16.11",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "mermaid": "^11.4.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.45.0",
    "shiki": "^1.24.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
