# HalfHalf 环境变量示例。复制成 .env 或在 docker run -e / compose 里设置。
# （.env 已被 .gitignore 忽略，不会入库。）

# 服务端口
PORT=3000

# 同时打开的 Chromium page 上限 = 约等于同时服务几个排版请求。
# 1G 内存务必设 1（并发渲染会 OOM）；内存越大可适当调高，每 +1 约多占 100~300MB。
HALFHALF_MAX_PAGES=1

# 以 root 跑容器时必须为 1（关闭 Chromium 沙箱，否则起不来）。
# 官方 Playwright 镜像默认 root，故默认需要它。
HALFHALF_CHROMIUM_NO_SANDBOX=1

# 前端静态产物目录。Docker 镜像里固定为 /app/web/dist；
# 本地非容器起 node dist 时指到 packages/web/dist。
HALFHALF_WEB_DIST=/app/web/dist

# 仅本地无 token 联调时放开 localhost 的 AI 端点；生产环境绝不要开。
# HALFHALF_AI_ALLOW_LOCALHOST=1
