# HalfHalf 环境变量示例。复制成 .env 或在 docker run -e / compose 里设置。
# （.env 已被 .gitignore 忽略，不会入库。）

# 服务端口
PORT=3000

# docker-compose 的端口绑定地址。生产保持 127.0.0.1，只让同机 Caddy 反代出 HTTPS；
# 明白自己在做什么再改 0.0.0.0——未加 HTTPS 直连公网会明文暴露材料与 BYOK key。
HALFHALF_BIND_ADDRESS=127.0.0.1

# 同时打开的 Chromium page 上限 = 约等于同时服务几个排版请求。
# 1G 内存务必设 1（并发渲染会 OOM）；内存越大可适当调高，每 +1 约多占 100~300MB。
HALFHALF_MAX_PAGES=1

# 以 root 跑容器时必须为 1（关闭 Chromium 沙箱，否则起不来）。
# 官方 Playwright 镜像默认 root，故默认需要它。
HALFHALF_CHROMIUM_NO_SANDBOX=1

# 前端静态产物目录。Docker 镜像里固定为 /app/web/dist；
# 本地非容器起 node dist 时指到 packages/web/dist。
HALFHALF_WEB_DIST=/app/web/dist

# —— PDF 原页保真 Worker ——
# 只有当某页字体损坏、需要回退成原页图像时才会拉起这个 Python 子进程。
# Docker 镜像里固定 /usr/bin/python3；本地不设会自动探测 .venv-parser 和 python3。
HALFHALF_PYTHON=/usr/bin/python3

# —— 导入队列 ——
# 一次 PDF 保真会同时吃 Chromium 和 PyMuPDF，1G 机器把并发钉在 1。
# 同步端点 /api/import/document 与异步队列共享这份额度，超出返回 429。
HALFHALF_IMPORT_CONCURRENCY=1
HALFHALF_IMPORT_OWNER_LIMIT=3     # 单客户端同时在跑的任务数
HALFHALF_IMPORT_GLOBAL_LIMIT=20   # 全局排队 + 运行中的任务数
HALFHALF_IMPORT_HISTORY_LIMIT=20  # 单客户端保留多少个终态任务

# 终态任务及其结果文件的保留时长（毫秒）。不设默认 30 分钟；下面是 7 天。
HALFHALF_IMPORT_JOB_TTL_MS=604800000

# 任务历史持久化。设了才启用：任务快照和已完成结果落盘，进程重启后仍可恢复；
# 不设则保持开发环境的纯内存行为（重启即清零）。生产务必指向持久卷。
# 落盘只记 SHA-256 所有者键，不存客户端 ID 或 IP；原始上传文件不落盘。
HALFHALF_DATA_DIR=/app/data

# —— 联网补洞（给已有材料的缺口找解释）——
# 设了才启用；不设时 /api/research/jobs 明确返回 501，绝不退化成让模型凭记忆编。
# 目前用智谱 web_search：它是纯搜索接口，返回必然带原文 URL（溯源是硬要求）。
# 实测：DeepSeek 不具备联网，传 enable_search 会 HTTP 200 静默忽略——别用它。
# HALFHALF_SEARCH_KEY=智谱的 key（bigmodel.cn）
# search_std / search_pro / search_pro_quark。实测 std 与 pro 结果相同，默认 std。
# HALFHALF_SEARCH_ENGINE=search_std
#
# 分节总结复用下面的 HALFHALF_AI_*，所以一把智谱 key 可以同时干搜索和总结两件事。
# 检索黑名单在 ${HALFHALF_DATA_DIR}/blocklist.txt，首次启动自动播种，改完即刻生效。

# 访问口令（部署闸门）：设了才启用，覆盖所有 /api/*（/api/health 放行）。
# 前端首次 401 时向用户要一次、存浏览器 localStorage。公网部署必设。
# HALFHALF_ACCESS_CODE=换成一串别人猜不到的口令

# —— ⓪ AI 结构化入口（材料转换）的服务器统一 key ——
# 三个都设了，用户不填自己的 key 也能用「材料转换」（费用记在这个 key 上，建议低价模型）。
# 端点是部署者自有配置、受信任（可指向白名单外的自建服务）；用户 BYOK 仍走域名白名单。
# HALFHALF_AI_ENDPOINT=https://api.deepseek.com/chat/completions
# HALFHALF_AI_MODEL=deepseek-chat
# HALFHALF_AI_KEY=sk-...

# 结构化接口的滥用防线（不设走默认值）
# HALFHALF_AI_RATE_LIMIT=10      # 每 IP 每小时次数上限
# HALFHALF_AI_MAX_INPUT=60000    # 单次输入字符上限

# 仅本地无 token 联调时放开 localhost 的 AI 端点；生产环境绝不要开。
# HALFHALF_AI_ALLOW_LOCALHOST=1

# —— L3 评测专用模型（可选，强烈建议配）——
# 刻意钉**最弱的支持档**：弱模型才暴露提示词缺陷。精简恒定失效、结构化编造
# 两个判例都是 glm-4-flash 先露出来的，换强模型会把提示词的毛病盖住。
# 三项不齐则整组回落到上面的 HALFHALF_AI_*（不许混搭）。
# HALFHALF_EVAL_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# HALFHALF_EVAL_MODEL=glm-4-flash
# HALFHALF_EVAL_KEY=...
